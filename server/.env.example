TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_USER_PHONE=
TELEGRAM_SESSION_DB=tele_session.db
TELEGRAM_GROUP_USERNAME=
TELEGRAM_GROUP_TIMEZONE=

DB_URL=openplays_local.db

LLM_BASE_URL=http://localhost:1234/v1
LLM_MODEL=
LLM_API_KEY=

ONEMAP_EMAIL=
ONEMAP_PASSWORD=

GOOGLE_PLACES_API_KEY=

GOOGLE_CLIENT_ID=

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Passwordless email login. EMAIL_FROM must use a domain verified by the provider.
EMAIL_OTP_ENABLED=
EMAIL_ALLOWED_DOMAINS=example.com,gmail.com,googlemail.com,outlook.com,hotmail.com,live.com,yahoo.com,icloud.com,me.com,mac.com,proton.me,protonmail.com,fastmail.com,zoho.com,aol.com,gmx.com
# Generate with: openssl rand -base64 32
EMAIL_OTP_SECRET=
# resend or smtp (smtp is for local Mailpit)
EMAIL_PROVIDER=resend
RESEND_API_KEY=
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
EMAIL_FROM=OpenPlays <login@example.com>

OBJECT_STORE_PROVIDER=r2
# Local defaults match compose.dev.yml. Replace these with R2 values in production.
OBJECT_STORE_BUCKET=openplays-local
OBJECT_STORE_PUBLIC_BASE_URL=http://localhost:9000/openplays-local
OBJECT_STORE_ENDPOINT=http://localhost:9000
OBJECT_STORE_ACCESS_KEY_ID=openplays
OBJECT_STORE_SECRET_ACCESS_KEY=openplays-local-secret

API_PORT=8080

COOKIE_SECURE=false # Only false for local development

# Local development only. Registers /api/dev/* auth helpers when true.
DEV_AUTH_ENABLED=

PUBLIC_DEV_REVIEWS_ALWAYS_OPEN=
